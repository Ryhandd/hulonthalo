# ===== Supabase (wajib) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_WA_NUMBER=62812xxxxxxx

# ===== Email verifikasi lewat Resend (opsional) =====
# KOSONG  = MODE DEVELOPMENT: akun baru langsung terkonfirmasi (auto-confirm), tanpa email.
# TERISI  = email verifikasi dikirim lewat Resend atas nama "Rumah Makan Hulonthalo".
RESEND_API_KEY=
# Pengirim. Sebelum domain terverifikasi, pakai: Rumah Makan Hulonthalo <onboarding@resend.dev>
# (hanya bisa mengirim ke email pemilik akun Resend). Setelah domain terverifikasi:
# Rumah Makan Hulonthalo <noreply@domainanda.com>
EMAIL_FROM="Rumah Makan Hulonthalo <onboarding@resend.dev>"
# URL situs: tujuan setelah klik tautan verifikasi (harus ada di Supabase > Authentication > URL Configuration > Redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== RAHASIA, hanya dipakai di server. JANGAN diberi awalan NEXT_PUBLIC_ =====
# Supabase > Project Settings > API > "service_role" key
SUPABASE_SERVICE_ROLE_KEY=
